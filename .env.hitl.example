BROWSER_HANDOFF_PUBLIC_HOST=127.0.0.1
BROWSER_HANDOFF_PUBLIC_SCHEME=http
BROWSER_HANDOFF_BIND_HOST=127.0.0.1
BROWSER_HANDOFF_TTL_SECONDS=900
BROWSER_HANDOFF_GATEWAY_PORT=0
BROWSER_HANDOFF_LOCK_WAIT_SECONDS=0
# Optional overrides
# BROWSER_HANDOFF_BASE_DIR=$HOME/.hermes/browser-handoff
# BROWSER_HANDOFF_PUBLIC_BASE_URL=https://handoff.example.ts.net
# BROWSER_HANDOFF_CHROMIUM_BIN=/usr/bin/google-chrome
# BROWSER_HANDOFF_HEADLESS=1
# BROWSER_HANDOFF_RUN_CLEANUP_BEFORE_OPEN=1
